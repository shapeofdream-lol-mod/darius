<Project>
  <Target Name="VerifyNativeModelBundleFreshness" BeforeTargets="VerifyPackageAssets">
    <PropertyGroup>
      <_NativeBundleStamp>$(ModRootDir)\assets\models\darius_models.bundle.fingerprint</_NativeBundleStamp>
      <_NativeBundleCheck>$(ModRootDir)\tools\DariusUnityAssets\Test-NativeModelBundle.ps1</_NativeBundleCheck>
      <PowerShellExe Condition="'$(PowerShellExe)' == '' and '$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
      <PowerShellExe Condition="'$(PowerShellExe)' == ''">pwsh</PowerShellExe>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NativeBundleStamp)')"
           Text="Native model bundle fingerprint is missing. Rebuild with tools/DariusUnityAssets/Build-NativeModels.ps1." />
    <Exec Command="$(PowerShellExe) -NoProfile -File &quot;$(_NativeBundleCheck)&quot; -RepoRoot &quot;$(ModRootDir)&quot;" />
  </Target>
</Project>
